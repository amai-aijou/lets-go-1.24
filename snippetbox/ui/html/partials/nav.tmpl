{{define "nav"}}
<nav>
	<div>
		<a href='/'>Home</a>
		<!-- 10.6: Toggle the link based on authentication status -->
		{{if .IsAuthenticated}}
		<!-- 7.1: Add a link to the new form -->
		<a href='/snippet/create'>Create snippet</a>
		{{end}}
	</div>
	<div>
		<!-- 10.6: Toggle the link based on authentication status -->
		{{if .IsAuthenticated}}
			<form action='/user/logout' method='POST'>
				<button>Logout</button>
			</form>
		{{else}}
		<a href='/user/signup'>Signup</a>
		<a href='/user/login'>Login</a>
		{{end}}
	</div>
</nav>
{{end}}
